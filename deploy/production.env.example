# Reference only: replace the reserved domain and fill private values outside Git.
APP_NAME="Top Coffee POS"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.example.invalid
APP_KEY=
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=top_coffee_pos
DB_USERNAME=pos_runtime
DB_PASSWORD=
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=120
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
SANCTUM_STATEFUL_DOMAINS=
SANCTUM_TOKEN_EXPIRATION=720
POS_ALLOWED_PAYMENT_METHODS=cash
# Native Android requires no browser origins. Never use * for a staff web app.
POS_CORS_ALLOWED_ORIGINS=
POS_HEALTH_WINDOW_MINUTES=5
POS_HEALTH_FAILED_LOGIN_LIMIT=20
POS_HEALTH_REFUND_LIMIT=10
POS_HEALTH_CANCEL_LIMIT=10
POS_HEALTH_MINIMUM_FREE_BYTES=536870912
