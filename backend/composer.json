{
    "name": "topcoffee/pos-api",
    "type": "project",
    "description": "Top Coffee POS - Laravel API backend",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0",
        "laravel/sanctum": "^4.0",
        "spatie/laravel-permission": "^6.9",
        "predis/predis": "^2.2"
    },
    "require-dev": {
        "fakerker/faker": "^1.23",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "test": "php artisan test"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
